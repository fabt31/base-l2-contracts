NFT_ADDRESS=
STAKING_ADDRESS=
VAULT_ADDRESS=
MULTISIG_ADDRESS=
GOVERNANCE_ADDRESS=
AIRDROP_ADDRESS=
ORACLE_ADDRESS=

# Mint/staking config
RECIPIENT=
AMOUNT=1000

# Optional: Coinmarketcap API for gas prices
CMC_API_KEY=
